{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "generated_at",
    "scenario_count",
    "case_count",
    "pattern_candidate_count",
    "anti_pattern_count",
    "input_meta_labels",
    "output_label"
  ],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "status": { "type": "string", "enum": ["passed", "blocked", "partial"] },
    "generated_at": { "type": "string" },
    "scenario_count": { "type": "integer" },
    "case_count": { "type": "integer" },
    "pattern_candidate_count": { "type": "integer" },
    "anti_pattern_count": { "type": "integer" },
    "method_fragment_count": { "type": "integer" },
    "input_meta_labels": { "type": "array", "items": { "type": "string" } },
    "output_label": { "type": "string" },
    "input_meta_dirs": { "type": "array", "items": { "type": "string" } },
    "output_dir": { "type": "string" }
  },
  "additionalProperties": true
}
