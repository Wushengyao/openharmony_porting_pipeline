{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "ledger_id": { "type": "string" },
    "device_id": { "type": "string" },
    "profile": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "jobs": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "job_id": { "type": "string" },
          "operation": { "type": "string" },
          "status": { "type": "string" },
          "command": { "type": "string" },
          "started_at": { "type": "string" },
          "ended_at": { "type": "string" },
          "image_sha256": { "type": "string" },
          "artifacts": {
            "type": "array",
            "items": { "type": "string" }
          },
          "evidence_refs": {
            "type": "array",
            "items": { "type": "string" }
          },
          "notes": { "type": "string" }
        },
        "required": ["job_id", "operation", "status", "command", "evidence_refs"],
        "additionalProperties": false
      }
    }
  },
  "required": ["ledger_id", "device_id", "created_at", "updated_at", "jobs"],
  "additionalProperties": false
}
